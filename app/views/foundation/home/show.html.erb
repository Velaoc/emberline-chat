<% identity = Rails.configuration.x.foundation %>
<% title "Chat with Emberline" %>

<section class="md-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">A chat that keeps every thread.</h1>
      <p>Sign in, start a conversation, and watch replies stream in as they're written. Conversations persist, so you can pick up tomorrow exactly where you stopped today.</p>
      <div class="md-actions">
        <%= link_to "Start chatting", new_user_registration_path, class: "md-button md-button--filled" %>
        <%= link_to "Sign in", new_user_session_path, class: "md-button md-button--outlined" %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="features-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">How it works</p>
    <h2 id="features-title" class="md-section__heading">Conversations that stream, persist, and belong to you.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:notifications, size: 32) %></span>
        <div>
          <h3>Streaming replies</h3>
          <p>Answers appear word by word over a single open connection — no waiting on a spinner for the whole response.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:workspaces, size: 32) %></span>
        <div>
          <h3>Persistent threads</h3>
          <p>Every message is saved as it arrives. Close the tab, come back later — the whole conversation is waiting.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:person, size: 32) %></span>
        <div>
          <h3>Private by account</h3>
          <p>Conversations are scoped to your account. Nobody else sees your threads, and you can delete any of them.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="md-section md-section--tonal" aria-labelledby="provider-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Under the hood</p>
    <h2 id="provider-title" class="md-section__heading">Provider-agnostic by design.</h2>
    <p>Emberline talks to any OpenAI-compatible chat API through a single adapter. This demo runs on a built-in canned provider that needs no keys — flip one configuration value and the same UI streams from your real provider.</p>
  </div>
</section>
