<% title "Chat" %>
<div class="emberline-shell" data-controller="chat" data-chat-new-url="<%= new_conversation_path %>">
  <aside class="emberline-sidebar" aria-label="Conversations">
    <div class="emberline-sidebar__header">
      <span class="emberline-sidebar__label">Conversations</span>
      <%= button_to "New chat", conversations_path, method: :post, class: "md-button md-button--filled md-button--compact", data: { turbo: false } %>
    </div>
    <nav class="emberline-convo-list">
      <% @conversations.each do |conversation| %>
        <%= link_to conversation_path(conversation), class: class_names("emberline-convo-item", active: conversation == @conversation), data: { turbo_frame: "chat" } do %>
          <span class="emberline-convo-item__title"><%= conversation.title %></span>
          <span class="emberline-convo-item__meta"><%= time_ago_in_words(conversation.updated_at) %> ago</span>
        <% end %>
      <% end %>
      <% if @conversations.empty? %>
        <p class="emberline-convo-empty">No conversations yet. Start one to begin.</p>
      <% end %>
    </nav>
  </aside>

  <main class="emberline-chat" tabindex="-1">
    <%= turbo_frame_tag "chat" do %>
      <% if @conversation %>
        <%= render "conversation", conversation: @conversation %>
      <% else %>
        <div class="emberline-empty">
          <h1>Pick a conversation</h1>
          <p>Or start a new one — replies stream in as they're written.</p>
          <%= button_to "New chat", conversations_path, method: :post, class: "md-button md-button--filled", data: { turbo: false } %>
        </div>
      <% end %>
    <% end %>
  </main>
</div>
